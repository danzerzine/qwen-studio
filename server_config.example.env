# Qwen Studio settings. Copy this file to server_config.env next to QwenStudio.exe.
# Paths may be absolute or relative to this folder. Studio rewrites the file when you change
# settings in the app (comments are not kept) — that is expected.

# API key for the llama.cpp server. Empty = no key. «Настройки → API-ключ» generates one.
LLAMA_API_KEY=

# 127.0.0.1 = this PC only; 0.0.0.0 = local network too («Настройки → Сеть → Доступ из локальной сети»).
HOST=127.0.0.1
PORT=8080
WEBUI_PORT=3000

# llama-server.exe. Empty = the newest llama-bNNNN folder next to the exe
# («Настройки → Обновления → llama.cpp» downloads the latest CUDA build there).
SERVER_EXE=
MODEL_PATH=models\your-model.gguf

# Optional second model for the «Запасная» switch (same modes, no MTP, context up to 96K).
FALLBACK_SERVER_EXE=
FALLBACK_MODEL_PATH=

# Optional uncensored fine-tune of the main model for the «Без цензуры» switch (same server, MTP and flags).
UNCENSORED_MODEL_PATH=

# Vision projector for the «Зрение» (vision) toggle (the mmproj-*.gguf published next to the model).
MMPROJ_PATH=

# ComfyUI for pictures: the portable build folder (with run_nvidia_gpu.bat) or a git checkout with a venv.
COMFYUI_DIR=
# Extra ComfyUI arguments, e.g. --listen 0.0.0.0 to reach it from the network.
COMFYUI_ARGS=

# GPU power limit in watts for the «Лимит мощности» button (empty = button hidden).
POWER_LIMIT_W=

# LM Studio's port: Studio unloads LM Studio models before starting so two models do not share the card.
LMSTUDIO_PORT=1234
