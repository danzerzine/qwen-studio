<Application x:Class="QwenStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- palette -->
        <!-- dark defaults; Core/Theme.cs swaps these at runtime -->
        <SolidColorBrush x:Key="Bg" Color="#222222"/>
        <SolidColorBrush x:Key="Surface" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="Surface2" Color="#343434"/>
        <SolidColorBrush x:Key="Hover" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="Line" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Text" Color="#E9E9E9"/>
        <SolidColorBrush x:Key="Muted" Color="#A8A8A8"/>
        <SolidColorBrush x:Key="Faint" Color="#7D7D7D"/>
        <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#7AD2FF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#22435A"/>
        <SolidColorBrush x:Key="Good" Color="#3DD68C"/>
        <SolidColorBrush x:Key="Warn" Color="#F5B94A"/>
        <SolidColorBrush x:Key="Bad" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="BadSoft" Color="#4F2D2F"/>
        <SolidColorBrush x:Key="OnAccent" Color="#0A1620"/>
        <SolidColorBrush x:Key="LogText" Color="#C1C1C1"/>
        <SolidColorBrush x:Key="ThumbBrush" Color="#525252"/>

        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <!-- tokens: see studio/DESIGN.md -->
        <sys:Double x:Key="S1">4</sys:Double>
        <sys:Double x:Key="S2">8</sys:Double>
        <sys:Double x:Key="S3">12</sys:Double>
        <sys:Double x:Key="S4">16</sys:Double>
        <sys:Double x:Key="S5">24</sys:Double>
        <Thickness x:Key="PagePad">24</Thickness>
        <Thickness x:Key="CardPad">16</Thickness>
        <Thickness x:Key="GapBelow">0,0,0,12</Thickness>
        <Thickness x:Key="GapBelowS">0,0,0,8</Thickness>
        <Thickness x:Key="CaptionGap">0,0,0,8</Thickness>
        <Thickness x:Key="HeaderPad">24,16</Thickness>
        <Thickness x:Key="BodyPad">24,0,24,24</Thickness>
        <Thickness x:Key="DividerGap">0,16</Thickness>
        <Thickness x:Key="GapTopS">0,8,0,0</Thickness>
        <Thickness x:Key="GapTop">0,12,0,0</Thickness>
        <Thickness x:Key="GapLeftS">8,0,0,0</Thickness>
        <Thickness x:Key="GapLeft">12,0,0,0</Thickness>
        <Thickness x:Key="GapRightS">0,0,8,0</Thickness>
        <Thickness x:Key="GapRight">0,0,12,0</Thickness>
        <Thickness x:Key="SegmentPad">4</Thickness>
        <GridLength x:Key="ColGapS">8</GridLength>
        <GridLength x:Key="ColGap">12</GridLength>
        <GridLength x:Key="ColGapL">24</GridLength>
        <GridLength x:Key="KeyColumn">72</GridLength>
        <GridLength x:Key="FieldColumn">160</GridLength>
        <sys:Double x:Key="ContentMaxWidth">880</sys:Double>
        <sys:Double x:Key="DotSize">8</sys:Double>
        <sys:Double x:Key="LogoSize">20</sys:Double>
        <GridLength x:Key="RowHeight">32</GridLength>
        <GridLength x:Key="FieldRow">40</GridLength>
        <Thickness x:Key="BarGap">1,0</Thickness>
        <sys:Double x:Key="ChartBaseline">2</sys:Double>
        <sys:Double x:Key="ChartTick">3</sys:Double>
        <sys:Double x:Key="ChartMinBar">3</sys:Double>
        <sys:Double x:Key="ChartStroke">2</sys:Double>
        <sys:Double x:Key="SeriesAltOpacity">0.45</sys:Double>
        <CornerRadius x:Key="RBar">2,2,0,0</CornerRadius>
        <CornerRadius x:Key="RControl">8</CornerRadius>
        <CornerRadius x:Key="RCard">12</CornerRadius>
        <CornerRadius x:Key="RPill">12</CornerRadius>
        <sys:Double x:Key="HControl">32</sys:Double>
        <sys:Double x:Key="HAction">40</sys:Double>
        <sys:Double x:Key="HCompact">28</sys:Double>
        <GridLength x:Key="SidebarWidth">288</GridLength>
        <sys:Double x:Key="ChartHeight">120</sys:Double>
        <sys:Double x:Key="IconS">12</sys:Double>
        <sys:Double x:Key="IconM">14</sys:Double>
        <sys:Double x:Key="IconL">16</sys:Double>

        <!-- type roles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="Display" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="BodyStrong" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="{StaticResource CaptionGap}"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="{StaticResource IconM}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RCard}"/>
            <Setter Property="Padding" Value="{StaticResource CardPad}"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RPill}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="{StaticResource DotSize}"/>
            <Setter Property="Height" Value="{StaticResource DotSize}"/>
            <Setter Property="Fill" Value="{DynamicResource Faint}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="{StaticResource GapBelow}"/>
        </Style>

        <!-- buttons -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="{StaticResource HControl}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RControl}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="{StaticResource HCompact}"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="{StaticResource IconM}"/>
            <Setter Property="MinWidth" Value="{StaticResource HCompact}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DangerOutline" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bad}"/>
            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RControl}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BadSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- segmented control: a Surface2 track (Segments) with Tab items -->
        <Style x:Key="Segments" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RControl}"/>
            <Setter Property="Padding" Value="{StaticResource SegmentPad}"/>
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RControl}" Padding="12,0" MinHeight="{StaticResource HCompact}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <!-- the app-wide TextBlock style would pin Text; follow the tab's Foreground (Muted / Text / Faint) -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <!-- not available (no model file): Faint is the disabled role; the reason is in the tooltip -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- profile card -->
        <Style x:Key="ProfileCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="{StaticResource GapBelowS}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{StaticResource RCard}" Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="{DynamicResource Surface2}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="2,0"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center">
                                <!-- the app-wide TextBlock style would pin Text; follow the toggle's Foreground so disabled reads Faint -->
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <!-- not available: Faint is the disabled role; the reason is in the tooltip -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Faint}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RControl}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- thin scrollbars -->
        <Style x:Key="Thumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ThumbBrush}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb><Thumb Style="{StaticResource Thumb}" Margin="1"/></Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb><Thumb Style="{StaticResource Thumb}" Margin="1"/></Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="{StaticResource HCompact}"/>
        </Style>
    </Application.Resources>
</Application>
